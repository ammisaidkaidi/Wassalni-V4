# ── Database (Supabase) ──────────────────────────────────────────────────────
# Project ref (the xxxxx in supabase.com/dashboard/project/xxxxx)
SUPABASE_PROJECT_REF=

# Option B: Supabase personal access token (sbp_…) — Management API transport
# Create one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Option A (preferred): direct Postgres — dashboard → Project Settings →
# Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ── Runtime mode ─────────────────────────────────────────────────────────────
# development (default) → dev_code in /api/auth/login response, codes logged
#   to console when SMTP isn't set, CORS reflects any origin, cookies are not
#   forced to Secure.
# production → never leak OTP codes anywhere, strict CORS default (same-origin
#   only unless CORS_ORIGIN is set), cookies forced Secure by default.
# NODE_ENV=production

# ── API server ───────────────────────────────────────────────────────────────
PORT=3000
# Only needed for a frontend hosted on a different origin than the one
# proxying /api to this server. Unset ⇒ same-origin only in production.
# CORS_ORIGIN=https://your-frontend-domain.example
# Force-disable Secure cookies (only for HTTP-only testing); defaults to true
# when NODE_ENV=production.
# COOKIE_SECURE=false
# Session lifetime (hours, default 168 = 7 days)
# SESSION_TTL_HOURS=168
# 2FA code lifetime (minutes, default 10)
# OTP_TTL_MINUTES=10
# MAX_FAILED_LOGINS=5
# LOCK_MINUTES=15

# ── Email (2FA codes) ────────────────────────────────────────────────────────
# Required for login/registration to fully work (every sign-in emails a 2FA
# code). Leave SMTP_HOST empty in development: codes are printed to the API
# console and returned as `dev_code` in the login response. In production,
# leaving it empty means codes are NEVER printed/leaked anywhere — login will
# be stuck at "check your email" until these are set. Configure real SMTP
# credentials for production:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Wassalni <no-reply@wassalni.dz>

# ── SMS (Task 17.1 notifications + Task 17.2 OTP alternative) ───────────────
# No real SMS vendor is wired in this codebase (api/sms.ts is a provider
# abstraction — add a real adapter for whichever carrier you use and set
# SMS_PROVIDER to its name). Leave unset to run in sandbox mode: SMS are
# logged to the console and recorded in `sms_log`, never actually delivered
# to a handset. In production, leaving this unset disables the SMS 2FA
# channel outright (it would otherwise silently never reach the user).
# SMS_PROVIDER=
# Per-phone-number ceiling on OTP SMS per rolling 24h window (abuse
# prevention, independent of the per-IP /api/auth rate limit).
# SMS_OTP_MAX_PER_PHONE_PER_DAY=10

# ── Web push (Task 16.2) ─────────────────────────────────────────────────────
# Generate once with `npx web-push generate-vapid-keys` and keep them stable:
# every browser subscription is bound to the public key it was created with,
# so rotating these invalidates every existing subscription. Leave unset in
# development: an ephemeral keypair is generated per process (push still
# works locally, it just won't survive a restart). Must be set in production.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact the push service may use to reach you about this app (mailto: or
# a URL), per the Web Push protocol's VAPID claims.
# VAPID_SUBJECT=mailto:support@wassalni.dz

# ── Init assets ──────────────────────────────────────────────────────────────
# SQL_SCHEMA_PATH=./data/init/sql.txt
# ALGERIA_DATA_PATH=./data/init/algeria.txt
